# Dashboard environment variables — copy to `.env.local` (gitignored) for local dev.
# See docs/DEPLOYMENT.md "Dashboard" for the full guide.

# --- GitHub OAuth (Auth.js) — REQUIRED for sign-in ---
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=

# --- Server-runtime config (read at request/deploy time) ---
# Target GitHub repo + the topic it publishes to. Same ARTISAN_ vocabulary as
# agents/src/artisan_agents/config.py.
ARTISAN_TARGET_REPO=403errors/artisan-demo
ARTISAN_PUBSUB_TOPIC=artisan-github-events
# GCP project for the server-side Firestore/PubSub clients (falls back to GOOGLE_CLOUD_PROJECT).
GCP_PROJECT_ID=artisan-multiagent-ai

# --- Client-visible config (inlined into the browser bundle at `pnpm build` time) ---
# Jira site for ticket deep-links; GCP project for Cloud Trace deep-links. Set these BEFORE
# building (build args in dashboard/Dockerfile for Cloud Run; .env.local before a local build).
NEXT_PUBLIC_JIRA_SITE=pieisnot22by7.atlassian.net
NEXT_PUBLIC_GCP_PROJECT_ID=artisan-multiagent-ai
